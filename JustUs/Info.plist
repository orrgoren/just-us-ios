<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Just Us</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.orrgoren.justus</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>justus</string>
      </array>
    </dict>
  </array>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <key>NSCameraUsageDescription</key>
  <string>Just Us uses the camera so you can send a photo in your private chat.</string>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>Just Us uses a photo you choose so you can send it in your private chat.</string>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>Just Us adds your planned evening to the calendar without the surprise itself.</string>
  <key>UIBackgroundModes</key>
  <array>
    <string>remote-notification</string>
  </array>
  <key>UILaunchScreen</key>
  <dict>
    <key>UIColorName</key>
    <string>LaunchBackground</string>
  </dict>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <key>UIUserInterfaceStyle</key>
  <string>Automatic</string>
  <key>SUPABASE_URL</key>
  <string>$(SUPABASE_URL)</string>
  <key>SUPABASE_ANON_KEY</key>
  <string>$(SUPABASE_ANON_KEY)</string>
  <key>APP_WEB_URL</key>
  <string>$(APP_WEB_URL)</string>
  <key>PRIVACY_POLICY_URL</key>
  <string>$(PRIVACY_POLICY_URL)</string>
  <key>SUPPORT_URL</key>
  <string>$(SUPPORT_URL)</string>
  <key>APP_ENVIRONMENT</key>
  <string>$(APP_ENVIRONMENT)</string>
  <key>APNS_ENABLED</key>
  <string>$(APNS_ENABLED)</string>
</dict>
</plist>
