{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just Us"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Just Us"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just Us adds your planned evening to the calendar without the surprise itself."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Just Us מוסיף את הערב המתוכנן ליומן, בלי ההפתעה עצמה."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just Us uses the camera so you can send a photo in your private chat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Just Us משתמש במצלמה כדי שתוכלו לשלוח תמונה בצ'אט הפרטי."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just Us uses a photo you choose so you can send it in your private chat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Just Us משתמש בתמונה שתבחרו כדי שתוכלו לשלוח אותה בצ'אט הפרטי."
          }
        }
      }
    }
  },
  "version": "1.0"
}
