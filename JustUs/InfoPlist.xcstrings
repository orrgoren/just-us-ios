            "value": "Just Us"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Just Us"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just Us adds your planned evening to the calendar without the surprise itself."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Just Us⁩ רושם את הערב ביומן, בלי ההפתעה."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just Us uses the camera so you can send a photo in your private chat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Just Us⁩ צריך את המצלמה כדי לשלוח תמונה בצ'אט הפרטי."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just Us uses a photo you choose so you can send it in your private chat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⁦Just Us⁩ צריך תמונה שתבחרו כדי לשלוח אותה בצ'אט הפרטי."
          }
        }
      }
    }
  },
  "version": "1.0"
}
