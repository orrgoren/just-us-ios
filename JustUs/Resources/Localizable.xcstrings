    "invite.stay": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נישאר איפה שאנחנו"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay where I am"
          }
        }
      }
    },
    "invite.replaceBody": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר יש לכם מרחב ריק, בלי בן או בת זוג ובלי ערב שמור. הצטרפות מוחקת את המרחב הריק ומחברת את החשבון להזמנה."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have an empty space, with no partner and no saved date. Joining removes that empty space and connects this account to the invite."
          }
        }
      }
    },
    "invite.joinBody": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקוד הזה עובד פעם אחת. ההצטרפות מחברת את החשבון למרחב שלהם, ורק לשלהם."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code works once. Joining connects this account to their space, and only theirs."
          }
        }
      }
    },
    "invite.keptBody": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחשבון הזה כבר יש מרחב עם היסטוריה. הזמנה לא יכולה להחליף אותו."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account already shares a space that has history. An invite can't replace it."
          }
        }
      }
    },
