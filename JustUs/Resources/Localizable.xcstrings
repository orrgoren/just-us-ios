    },
    "role.waiting": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחכים להם"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting on them"
          }
        }
      }
    },
    "auth.next": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השלב הבא: כניסה. אחר כך פותחים מרחב, או מצטרפים לשלהם."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next: sign in. Then make a space, or join theirs."
          }
        }
      }
    },
    "auth.codeNext": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישור הוא הדרך פנימה. הקוד כאן אם כבר יש לכם אותו."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link is the way in. The code is there if you already have it."
          }
        }
      }
    },
    "invite.next": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלחו את קישור האפליקציה. הוא פותח את Just Us אצלם."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the app link. It opens Just Us on their phone."
          }
        }
      }
    },
    "invite.appLink": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נפתח באפליקציה"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens in the app"
          }
        }
      }
    },
    "invite.joinNext": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדביקו את הקוד שלהם. אתם מצטרפים למרחב שלהם, לא פותחים חדש."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste their code. You join their space, not a new one."
          }
        }
      }
    },
    "celebrate.space": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המרחב שלכם מוכן."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your space is ready."
          }
        }
      }
    },
    "celebrate.paired": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתם מחוברים. השבוע שלכם."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're paired. The week is yours."
          }
        }
      }
    },
    "celebrate.night": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערב נקבע."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The night is set."
          }
        }
      }
    },
    "ritual.waitHelp": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מה לעשות עד שהם יפתחו את הקישור."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing else for you until they open the link."
          }
        }
      }
    },
    "ritual.plannerHelp": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתם מתכננים. הם רואים את הרמז, לא את ההפתעה, עד שתחשפו."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're planning. They see the hint, not the surprise, until you reveal it."
          }
        }
      }
    },
    "ritual.partnerPlan": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הם מתכננים. בחרו מצב רוח, וחכו לרמז."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They're planning. Pick your mood, then wait for the hint."
          }
        }
      }
    },
    "ritual.moodHelp": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב רוח אחד. הם יראו את שלכם. התוכנית נשארת אצל מי שמתכנן."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One mood. They'll see yours. The plan stays with the planner."
          }
        }
      }
    },
    "memories.next": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא חובה. שורה או תמונה, אחרי שהערב נגמר."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. A line or a photo, once the night is done."
          }
        }
      }
    },
    "settings.next": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמות חובה. התזכורות לא."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names are required. The nudges are optional."
          }
        }
      }
    },
    "push.next": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תורכם. תגידו כן אם בא לכם נדנוד כשהם מצטרפים."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your turn. Say yes if you want a nudge when they join."
          }
        }
      }
    },
    "setup.create": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניצור את המרחב שלנו"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create our space"
          }
        }
      }
    },
    "setup.join": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לי קוד להצטרפות"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join with a code instead"
          }
        }
      }
