    "invite.title": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזמינו אותם"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring them in"
