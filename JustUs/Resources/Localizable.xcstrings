    },
    "invite.body": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתפו קישור חד־פעמי, או תקריאו את הקוד. הוא תקף שבעה ימים."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share a one-time link, or read them the code. It lasts seven days."
          }
        }
      }
    },
    "invite.share": {
