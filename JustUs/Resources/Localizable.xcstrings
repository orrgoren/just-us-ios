    "ritual.partnerPlanning": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ על התכנון הפעם. בחרו מצב רוח, והרמז יופיע כשזה מוכן."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is planning this one. Pick a mood. The hint shows up when it's ready."
          }
        }
      }
    },
