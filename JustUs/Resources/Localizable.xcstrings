    "setup.durationHelp": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדרך כלל שעה וחצי. אפשר לשנות אם אצלכם זה יותר."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "90 minutes is the usual evening. Change it if yours runs longer."
          }
        }
      }
    },
    "setup.next": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תורכם. מלאו את זה, ואז שלחו להם קישור."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your turn. Fill this in, then send them a link."
          }
        }
      }
    },
    "setup.namesHelp": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הם יראו את השם שבחרתם כשיצטרפו."
