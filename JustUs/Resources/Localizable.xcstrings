    "auth.loginBody": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להיכנס עם Apple, או עם קישור שנשלח לאימייל באייפון הזה."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple, or with a link we email to this iPhone."
          }
        }
      }
    },
