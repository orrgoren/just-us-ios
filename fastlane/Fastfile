# APNS_KEY_ID (S6M487B43U) and APNS_KEY_P8 are for the Supabase Edge Function,
# documented in docs/supabase-apple-and-apns.md. This lane does not read them.
default_platform(:ios)

BUNDLE_IDENTIFIER = "com.orrgoren.justus"
BUNDLE_RESOURCE_ID = "XZ2BWSBK3R"
APP_STORE_PROFILE_NAME = "Just Us App Store"
REQUIRED_CAPABILITIES = %w[PUSH_NOTIFICATIONS APPLE_ID_AUTH].freeze
# Apple Distribution and the older iOS Distribution type. Development, Mac, and
# Developer ID certificates are left alone.
DISTRIBUTION_CERTIFICATE_TYPES = [
  "DISTRIBUTION",
  "IOS_DISTRIBUTION"
].freeze

platform :ios do
  desc "Verify the existing App ID, archive Release with App Store distribution signing, upload to internal TestFlight. Does not register a bundle id or a device."
  lane :beta do
    api_key = connect_api_key
    revoke_distribution_certificates
    bundle = verify_existing_bundle_id
    ensure_app_store_record(bundle)
    ipa = archive_release(api_key)
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "Internal TestFlight build of Just Us."
    )
  end
end

def connect_api_key
  require_env!("ASC_KEY_ID", "ASC_ISSUER_ID", "ASC_KEY_P8", "APPLE_TEAM_ID")
  key_content = normalized_p8(ENV.fetch("ASC_KEY_P8"))
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: key_content,
    is_key_content_base64: false,
    duration: 1200,
    in_house: false
  )
end

def verify_existing_bundle_id
  UI.message("Checking App ID #{BUNDLE_IDENTIFIER} (#{BUNDLE_RESOURCE_ID}). Registration is skipped.")
  bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_IDENTIFIER)
  UI.user_error!("App ID #{BUNDLE_IDENTIFIER} was not found. This lane does not create it.") if bundle.nil?
  unless bundle.id == BUNDLE_RESOURCE_ID
    UI.user_error!("Found #{bundle.identifier} but resource id is #{bundle.id}, expected #{BUNDLE_RESOURCE_ID}.")
  end
  present = bundle.get_capabilities.map { |capability| capability.capability_type.to_s }
  missing = REQUIRED_CAPABILITIES - present
  unless missing.empty?
    UI.user_error!("App ID is missing capabilities: #{missing.join(', ')}. Present: #{present.join(', ')}.")
  end
  UI.success("Verified #{bundle.identifier} (#{bundle.id}) with #{REQUIRED_CAPABILITIES.join(' and ')}.")
  bundle
end

def ensure_app_store_record(bundle)
  existing = Spaceship::ConnectAPI::App.find(BUNDLE_IDENTIFIER)
  if existing
    UI.success("App Store Connect app already exists (#{existing.id}).")
    return existing
  end
  UI.message("Creating the App Store Connect app record. The App ID itself is not modified.")
  Spaceship::ConnectAPI::App.create(
    name: "Just Us Couples",
    bundle_id: bundle.id,
    sku: "just-us-ios",
    primary_locale: "en-US",
    platforms: ["IOS"],
    version_string: "1.0"
  )
end

def archive_release(api_key)
  team_id = ENV.fetch("APPLE_TEAM_ID")
  profile_name = install_app_store_signing(api_key, team_id)
  # Manual signing is written onto the JustUs app target only. Global xcargs
  # would also hit Swift package targets such as swift-crypto, which reject a
  # provisioning profile. Debug stays Automatic for the unsigned CI test build.
  # -allowProvisioningUpdates is omitted so Xcode does not request a
  # Development profile. This team has no devices.
  update_code_signing_settings(
    path: "JustUs.xcodeproj",
    use_automatic_signing: false,
    targets: ["JustUs"],
    build_configurations: ["Release"],
    team_id: team_id,
    code_sign_identity: "Apple Distribution",
    profile_name: profile_name
  )
  # Fastlane's working directory is fastlane/, so a relative ./build expands to
  # fastlane/build. Gym writes the ipa next to the project. Use the absolute
  # path build_app returns instead of expanding a relative path here.
  output_directory = File.expand_path("../build", __dir__)
  build_number = next_testflight_build_number(api_key)
  ipa = build_app(
    project: "JustUs.xcodeproj",
    scheme: "JustUs",
    configuration: "Release",
    export_method: "app-store",
    export_team_id: team_id,
    skip_profile_detection: true,
    output_directory: output_directory,
    output_name: "JustUs.ipa",
    clean: true,
    # A version setting only. Signing stays off xcargs so package targets are
    # not given a provisioning profile.
    xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
    export_options: {
      signingStyle: "manual",
      signingCertificate: "Apple Distribution",
      teamID: team_id,
      provisioningProfiles: {
        BUNDLE_IDENTIFIER => profile_name
      }
    }
  )
  ipa = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] if ipa.to_s.empty?
  UI.user_error!("Archive did not produce #{ipa}") if ipa.to_s.empty? || !File.exist?(ipa)
  ipa
end

def next_testflight_build_number(api_key)
  # The action's own default for "no uploads" is 1. Passing 0 keeps the first
  # upload at build 1 after adding one. An existing build 1 becomes 2.
  latest = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: BUNDLE_IDENTIFIER,
    initial_build_number: 0
  )
  number = latest.to_i + 1
  UI.user_error!("TestFlight build number #{number} is not a positive integer.") unless number.positive?
  UI.success("Next TestFlight build number is #{number}.")
  number
end

def install_app_store_signing(api_key, team_id)
  signing_dir = File.expand_path("../build/signing", __dir__)
  FileUtils.mkdir_p(signing_dir)
  keychain_path = prepare_runner_keychain

  UI.message("Installing one Apple Distribution certificate into the runner keychain. No development certificate is requested.")
  get_certificates(
    {
      api_key: api_key,
      development: false,
      generate_apple_certs: true,
      team_id: team_id,
      platform: "ios",
      output_path: signing_dir
    }.merge(keychain_args(keychain_path))
  )
  cert_id = Actions.lane_context[SharedValues::CERT_CERTIFICATE_ID]
  UI.user_error!("Apple Distribution certificate was not installed.") if cert_id.to_s.empty?

  delete_named_app_store_profile
  UI.message("Installing the App Store profile for #{BUNDLE_IDENTIFIER} against #{cert_id}. No devices and no development profile.")
  get_provisioning_profile(
    api_key: api_key,
    app_identifier: BUNDLE_IDENTIFIER,
    team_id: team_id,
    platform: "ios",
    cert_id: cert_id,
    provisioning_name: APP_STORE_PROFILE_NAME,
    force: true,
    output_path: signing_dir,
    filename: "AppStore.mobileprovision",
    skip_install: false
  )
  profile_name = Actions.lane_context[SharedValues::SIGH_NAME]
  profile_type = Actions.lane_context[SharedValues::SIGH_PROFILE_TYPE].to_s
  UI.user_error!("App Store profile was not installed.") if profile_name.to_s.empty?
  UI.user_error!("Expected an app-store profile, got #{profile_type}.") unless profile_type == "app-store"
  unless profile_name == APP_STORE_PROFILE_NAME
    UI.user_error!("Expected profile #{APP_STORE_PROFILE_NAME}, got #{profile_name}.")
  end
  UI.success("Using App Store profile #{profile_name}.")
  profile_name
end

def revoke_distribution_certificates
  # The runner keychain is empty, so every previous private key is gone and
  # those certificates can never sign again. Revoking them frees the account
  # slot. Apple re-signs builds it has already accepted, so this does not
  # remove an uploaded TestFlight or App Store build.
  certs = Spaceship::ConnectAPI::Certificate.all(
    filter: { certificateType: DISTRIBUTION_CERTIFICATE_TYPES.join(",") }
  )
  certs.select! { |cert| DISTRIBUTION_CERTIFICATE_TYPES.include?(cert.certificate_type) }
  if certs.empty?
    UI.message("No Apple Distribution or iOS Distribution certificates to revoke.")
    return
  end
  certs.each do |cert|
    UI.message("Revoking #{cert.certificate_type} #{cert.id} (#{cert.display_name}).")
    cert.delete!
  end
  UI.success("Revoked #{certs.length} distribution certificate(s) on team #{ENV.fetch('APPLE_TEAM_ID')}.")
end

def delete_named_app_store_profile
  profiles = Spaceship::ConnectAPI::Profile.all(filter: { name: APP_STORE_PROFILE_NAME })
  matches = profiles.select { |profile| profile.name == APP_STORE_PROFILE_NAME }
  return if matches.empty?

  matches.each do |profile|
    UI.message("Removing provisioning profile #{profile.name} (#{profile.id}) so it can be recreated for the new certificate.")
    profile.delete!
  end
end

def prepare_runner_keychain
  return nil unless ENV["CI"]

  setup_ci
  raw = Actions.lane_context[SharedValues::KEYCHAIN_PATH]
  UI.user_error!("CI keychain was not created.") if raw.to_s.empty?
  expanded = File.expand_path(raw)
  path = ["#{expanded}-db", expanded].find { |candidate| File.exist?(candidate) }
  UI.user_error!("CI keychain was not found at #{expanded}.") if path.nil?
  path
end

def keychain_args(keychain_path)
  return {} if keychain_path.nil?

  { keychain_path: keychain_path, keychain_password: "" }
end

def require_env!(*names)
  missing = names.select { |name| ENV[name].to_s.strip.empty? }
  return if missing.empty?

  UI.user_error!("Missing environment: #{missing.join(', ')}. APNS key secrets are not required for this upload.")
end

def normalized_p8(raw)
  text = raw.to_s.strip
  return text if text.include?("BEGIN PRIVATE KEY")

  require "base64"
  Base64.decode64(text).force_encoding("UTF-8")
end
